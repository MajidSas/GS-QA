{
  "question": "What\u2019s the nearest caf\u00e9 along the path leading from Out of Africa Wildlife Park, Camp Verde, AZ to 7 Wonders Gallery, Flagstaff, AZ?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-111.9207 34.612641)',4326)::geography, ST_GeomFromText('POINT (-111.659437 35.192476)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-111.9207 34.612641)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-111.9207 34.612641)',4326)::geography ASC\nLIMIT 1;\n",
