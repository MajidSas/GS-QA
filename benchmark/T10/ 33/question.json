  "question": "What\u2019s the nearest museum along the path leading from the Lake House, East Springfield, PA to UPMC Hillman Cancer Center, Erie, PA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.433908 41.993983)',4326)::geography, ST_GeomFromText('POINT (-80.137019 42.10374)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.433908 41.993983)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-80.433908 41.993983)',4326)::geography ASC\nLIMIT 1;\n",
