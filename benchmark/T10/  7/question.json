  "question": "What\u2019s the nearest hotel when heading from Hashimoto Contemporary, New York, NY toward Keyport Historical Society, Keyport, NJ?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.9827 40.718445)',4326)::geography, ST_GeomFromText('POINT (-74.203148 40.436168)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'hotel'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.9827 40.718445)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-73.9827 40.718445)',4326)::geography ASC\nLIMIT 1;\n",
