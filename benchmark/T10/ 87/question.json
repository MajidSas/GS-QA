  "question": "What\u2019s the nearest museum along the travel direction from Mays Chapel Medical Care Center, Lutherville, MD to Herman Maril Gallery, College Park, MD?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.663402 39.458755)',4326)::geography, ST_GeomFromText('POINT (-76.947284 38.985128)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.663402 39.458755)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-76.663402 39.458755)',4326)::geography ASC\nLIMIT 1;\n",
