  "question": "Which caf\u00e9 is closest while moving toward National Electronics Museum, Linthicum, MD from Battle of the Bulge Memorial, VA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.075579 38.874957)',4326)::geography, ST_GeomFromText('POINT (-76.684206 39.195792)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.075579 38.874957)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-77.075579 38.874957)',4326)::geography ASC\nLIMIT 1;\n",
