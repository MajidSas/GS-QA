  "question": "What\u2019s the nearest museum on the way from Wagner Hotel, New York, NY toward Sculpture Center, Long Island City, NY?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-74.017294 40.705449)',4326)::geography, ST_GeomFromText('POINT (-73.940864 40.746908)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-74.017294 40.705449)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-74.017294 40.705449)',4326)::geography ASC\nLIMIT 1;\n",
