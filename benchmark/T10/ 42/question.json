{
  "question": "Which fast food comes up first when traveling toward Faith Arena, Surprise, AZ from Maryvale Baseball Park, Phoenix, AZ?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-112.173653 33.489497)',4326)::geography, ST_GeomFromText('POINT (-112.371855 33.62819)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-112.173653 33.489497)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-112.173653 33.489497)',4326)::geography ASC\nLIMIT 1;\n",
