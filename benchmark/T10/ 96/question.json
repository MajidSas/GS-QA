  "question": "Which fast food is closest on the journey from Omni Scottsdale Resort & Spa at Montelucia, Paradise Valley, AZ to Arizona State University Art Museum, Tempe, AZ?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-111.972351 33.529412)',4326)::geography, ST_GeomFromText('POINT (-111.938104 33.418674)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-111.972351 33.529412)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-111.972351 33.529412)',4326)::geography ASC\nLIMIT 1;\n",
