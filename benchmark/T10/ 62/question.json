  "question": "Which caf\u00e9 is closest on the corridor from Alta Vista Gardens, Vista, CA to BLK Box Gallery and Creative Center, San Ysidro, CA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.219371 33.210166)',4326)::geography, ST_GeomFromText('POINT (-117.044038 32.552473)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.219371 33.210166)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-117.219371 33.210166)',4326)::geography ASC\nLIMIT 1;\n",
