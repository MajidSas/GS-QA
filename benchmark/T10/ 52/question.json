  "question": "Which caf\u00e9 lies closest ahead of House Of Sports, Ardsley, NY toward White Memorial Foundation, Litchfield, CT?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.849839 41.012013)',4326)::geography, ST_GeomFromText('POINT (-73.213489 41.724615)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.849839 41.012013)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-73.849839 41.012013)',4326)::geography ASC\nLIMIT 1;\n",
