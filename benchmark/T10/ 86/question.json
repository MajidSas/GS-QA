  "question": "What\u2019s the nearest fast food along the travel direction from Oxbow Park and Zollman Zoo, Byron, MN to Best Western, Rochester, MN?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-92.648741 44.083478)',4326)::geography, ST_GeomFromText('POINT (-92.485121 44.002954)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-92.648741 44.083478)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-92.648741 44.083478)',4326)::geography ASC\nLIMIT 1;\n",
