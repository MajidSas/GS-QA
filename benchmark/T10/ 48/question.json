{
  "question": "Which gallery comes up first when traveling toward Disneyland Resort, Anaheim, CA from Country Inn & Suites, Redlands, CA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.20961 34.065541)',4326)::geography, ST_GeomFromText('POINT (-117.918953 33.809089)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'gallery'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.20961 34.065541)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-117.20961 34.065541)',4326)::geography ASC\nLIMIT 1;\n",
