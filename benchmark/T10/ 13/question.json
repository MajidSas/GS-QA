  "question": "Which fast food lies closest ahead of Zero Whiskey Tactical Arms, Austin, TX toward South University, Austin, Round Rock, TX?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-97.715155 30.344507)',4326)::geography, ST_GeomFromText('POINT (-97.689962 30.479356)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-97.715155 30.344507)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-97.715155 30.344507)',4326)::geography ASC\nLIMIT 1;\n",
