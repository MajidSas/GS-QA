  "question": "What\u2019s the closest restaurant aligned with the route to C.S.U. Technology Park, Long Beach, CA from Hollywood Sign, Los Angeles, CA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-118.321652 34.134099)',4326)::geography, ST_GeomFromText('POINT (-118.221672 33.790124)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'restaurant'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-118.321652 34.134099)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-118.321652 34.134099)',4326)::geography ASC\nLIMIT 1;\n",
