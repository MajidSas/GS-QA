  "question": "What\u2019s the nearest fast food along the travel direction from Cal, Sr.'s Yard, Aberdeen, MD to West Chester Griswolds, West Chester, PA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.186327 39.533089)',4326)::geography, ST_GeomFromText('POINT (-75.511855 39.976149)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.186327 39.533089)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-76.186327 39.533089)',4326)::geography ASC\nLIMIT 1;\n",
