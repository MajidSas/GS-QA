{
  "question": "Which hotel is closest forward of West End Park, Queensbury, NY when heading toward College of Saint Joseph, Rutland, VT?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.679735 43.302111)',4326)::geography, ST_GeomFromText('POINT (-73.000884 43.600546)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'hotel'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.679735 43.302111)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-73.679735 43.302111)',4326)::geography ASC\nLIMIT 1;\n",
