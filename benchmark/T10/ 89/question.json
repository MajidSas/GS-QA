{
  "question": "Which caf\u00e9 lies closest ahead of Greenpoint Gallery, Brooklyn, NY toward Frank Sinatra's Birthplace, Hoboken, NJ?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.95243 40.736354)',4326)::geography, ST_GeomFromText('POINT (-74.038603 40.743437)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.95243 40.736354)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-73.95243 40.736354)',4326)::geography ASC\nLIMIT 1;\n",
