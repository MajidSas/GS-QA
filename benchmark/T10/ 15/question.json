{
  "question": "Which caf\u00e9 is nearest along the route connecting John Natsoulas Gallery, Davis, CA to the Wright Institute, Berkeley, CA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-121.740978 38.54212)',4326)::geography, ST_GeomFromText('POINT (-122.253167 37.868383)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-121.740978 38.54212)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-121.740978 38.54212)',4326)::geography ASC\nLIMIT 1;\n",
