{
  "question": "Which restaurant is closest as you approach School 31 Luxury Lofts, Rochester, NY starting from Shop One, Rochester, NY?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.680465 43.08274)',4326)::geography, ST_GeomFromText('POINT (-77.585334 43.157228)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'restaurant'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.680465 43.08274)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-77.680465 43.08274)',4326)::geography ASC\nLIMIT 1;\n",
