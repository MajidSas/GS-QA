{
  "question": "Which fast food comes up first when traveling toward the Keath House, Manheim, PA from Mays Chapel Medical Care Center, Lutherville, MD?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.663402 39.458755)',4326)::geography, ST_GeomFromText('POINT (-76.394069 40.16458)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.663402 39.458755)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-76.663402 39.458755)',4326)::geography ASC\nLIMIT 1;\n",
