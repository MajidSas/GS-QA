  "question": "Which viewpoint lie within 40 kilometers along the southwest axis from Mission Hills Church Park, San Marcos, CA?",
  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-117.148078 33.148133)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-117.148078 33.148133)',4326)::geography, 40000)\nAND tourism = 'viewpoint'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 202.5 AND 247.5;\n",
