  "question": "Which park can be found northeast of Pine Grove Zoo, Little Falls, MN inside a 140 kilometers range?",
  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-94.383608 45.979142)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-94.383608 45.979142)',4326)::geography, 140000)\nAND leisure = 'park'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 22.5 AND 67.5;\n",
