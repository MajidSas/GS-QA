  "question": "What university exist within an 80 kilometers distance east of Hotel UMass, Amherst, MA?",
  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-72.527124 42.391734)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-72.527124 42.391734)',4326)::geography, 80000)\nAND amenity = 'university'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 67.5 AND 112.5;\n",
