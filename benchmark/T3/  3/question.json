{
  "question": "What viewpoint can I find east of West End Park, Queensbury, NY, limited to 50 kilometers?",
  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-73.679735 43.302111)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-73.679735 43.302111)',4326)::geography, 50000)\nAND tourism = 'viewpoint'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 67.5 AND 112.5;\n",
