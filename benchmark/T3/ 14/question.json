  "question": "Which nature reserve can be found southwest of Woodstock Mural and Sculpture Garden, Woodstock, IL inside a 150 kilometers range?",
  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-88.447936 42.316158)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-88.447936 42.316158)',4326)::geography, 150000)\nAND leisure = 'nature_reserve'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 202.5 AND 247.5;\n",
