  "question": "Which park can be found within 120 kilometers toward the east of Illinois Central Depot, Bethany, IL?",
  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-88.739562 39.646085)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-88.739562 39.646085)',4326)::geography, 120000)\nAND leisure = 'park'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 67.5 AND 112.5;\n",
