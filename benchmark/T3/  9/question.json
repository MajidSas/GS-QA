  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-104.990709 39.728464)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-104.990709 39.728464)',4326)::geography, 30000)\nAND leisure = 'stadium'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 112.5 AND 157.5;\n",
