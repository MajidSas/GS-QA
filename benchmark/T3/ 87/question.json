  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-80.080644 42.110128)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-80.080644 42.110128)',4326)::geography, 120000)\nAND tourism = 'museum'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 157.5 AND 202.5;\n",
