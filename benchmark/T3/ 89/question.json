  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-101.316102 48.206438)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-101.316102 48.206438)',4326)::geography, 190000)\nAND amenity = 'restaurant'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 202.5 AND 247.5;\n",
