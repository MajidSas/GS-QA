  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.909905 40.667715)',4326)::geography, ST_GeomFromText('POINT (-76.88992 40.269316)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-77.909905 40.667715)',4326)::geography, 100000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.909905 40.667715)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
