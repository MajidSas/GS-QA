  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-93.234364 44.913029)',4326)::geography, ST_GeomFromText('POINT (-92.627437 44.855166)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-93.234364 44.913029)',4326)::geography, 80000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-93.234364 44.913029)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
