  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-75.695391 39.329473)',4326)::geography, ST_GeomFromText('POINT (-76.604443 39.288138)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-75.695391 39.329473)',4326)::geography, 80000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-75.695391 39.329473)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
