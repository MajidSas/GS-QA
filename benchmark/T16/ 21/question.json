  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-89.684904 39.78926)',4326)::geography, ST_GeomFromText('POINT (-89.781729 39.004152)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-89.684904 39.78926)',4326)::geography, 120000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-89.684904 39.78926)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
