  "question": "Where can I find attraction inside 130 kilometers while progressing from English Street Community Garden, New Haven, CT toward Montefiore Medical Center - Wakefield Campus, Bronx, NY?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-72.896423 41.316453)',4326)::geography, ST_GeomFromText('POINT (-73.861082 40.893776)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'attraction'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-72.896423 41.316453)',4326)::geography, 130000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-72.896423 41.316453)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
