  "question": "Where can I find hotel inside 80 kilometers while progressing from Acushnet Sawmill, Acushnet, MA toward Drive By Projects, Watertown, MA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-70.919597 41.683778)',4326)::geography, ST_GeomFromText('POINT (-71.181915 42.367852)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'hotel'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-70.919597 41.683778)',4326)::geography, 80000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-70.919597 41.683778)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
