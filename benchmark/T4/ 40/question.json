  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.919902 33.807062)',4326)::geography, ST_GeomFromText('POINT (-118.321652 34.134099)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'hotel'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-117.919902 33.807062)',4326)::geography, 90000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.919902 33.807062)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
