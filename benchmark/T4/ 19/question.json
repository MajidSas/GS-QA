  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.022498 38.877195)',4326)::geography, ST_GeomFromText('POINT (-76.599735 39.283445)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'gallery'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-77.022498 38.877195)',4326)::geography, 170000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.022498 38.877195)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
