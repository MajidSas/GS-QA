  "question": "What hotel are present within 190 kilometers when moving toward Rose Art Museum, Waltham, MA starting at Acushnet Sawmill, Acushnet, MA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-70.919597 41.683778)',4326)::geography, ST_GeomFromText('POINT (-71.262505 42.365638)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'hotel'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-70.919597 41.683778)',4326)::geography, 190000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-70.919597 41.683778)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
