{
  "question": "Which attraction can I find within a 190 kilometers radius while heading toward Turtle Island Park, Lake in the Hills, IL?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-89.010008 42.550505)',4326)::geography, ST_GeomFromText('POINT (-88.328177 42.185635)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'attraction'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-89.010008 42.550505)',4326)::geography, 190000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-89.010008 42.550505)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
