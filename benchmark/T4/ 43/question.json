  "question": "Which museum can I find within 150 kilometers while progressing toward Westchester Women's Medical Healthcare, Mount Vernon, NY from Hashimoto Contemporary, New York, NY?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.9827 40.718445)',4326)::geography, ST_GeomFromText('POINT (-73.839837 40.911646)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-73.9827 40.718445)',4326)::geography, 150000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.9827 40.718445)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
