  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.075579 38.874957)',4326)::geography, ST_GeomFromText('POINT (-76.888029 39.004832)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-77.075579 38.874957)',4326)::geography, 40000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-77.075579 38.874957)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
