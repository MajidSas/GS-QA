  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-97.715155 30.344507)',4326)::geography, ST_GeomFromText('POINT (-97.312774 30.537702)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'restaurant'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-97.715155 30.344507)',4326)::geography, 130000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-97.715155 30.344507)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
