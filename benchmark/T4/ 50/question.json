  "question": "Which hotel fall within 140 kilometers when heading from Sky Oaks Reserve, Warner Springs, CA toward Santa Ana River Trail & Parkway, San Bernardino, CA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-116.62249 33.374661)',4326)::geography, ST_GeomFromText('POINT (-117.279025 34.070013)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'hotel'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-116.62249 33.374661)',4326)::geography, 140000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-116.62249 33.374661)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
