  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.318615 42.000159)',4326)::geography, ST_GeomFromText('POINT (-80.084642 42.050192)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE leisure = 'nature_reserve'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-80.318615 42.000159)',4326)::geography, 60000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.318615 42.000159)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
