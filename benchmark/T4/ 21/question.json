  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-98.133046 26.288188)',4326)::geography, ST_GeomFromText('POINT (-97.672162 26.163574)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-98.133046 26.288188)',4326)::geography, 160000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-98.133046 26.288188)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
