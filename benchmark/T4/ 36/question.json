  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-83.564838 35.797212)',4326)::geography, ST_GeomFromText('POINT (-84.272003 36.02315)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-83.564838 35.797212)',4326)::geography, 180000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-83.564838 35.797212)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
