  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-82.34337 30.543305)',4326)::geography, ST_GeomFromText('POINT (-82.387146 29.67614)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'hospital'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-82.34337 30.543305)',4326)::geography, 80000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-82.34337 30.543305)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
