  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.824345 35.212772)',4326)::geography, ST_GeomFromText('POINT (-80.579942 35.570133)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'gallery'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-80.824345 35.212772)',4326)::geography, 60000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.824345 35.212772)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
