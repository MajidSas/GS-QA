  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-71.04755 41.690084)',4326)::geography, ST_GeomFromText('POINT (-70.184796 42.052807)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'restaurant'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-71.04755 41.690084)',4326)::geography, 120000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-71.04755 41.690084)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
