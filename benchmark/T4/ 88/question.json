  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-122.432984 47.131086)',4326)::geography, ST_GeomFromText('POINT (-122.59991 47.172323)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'cafe'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-122.432984 47.131086)',4326)::geography, 190000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-122.432984 47.131086)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
