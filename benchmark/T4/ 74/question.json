  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-98.582518 33.854202)',4326)::geography, ST_GeomFromText('POINT (-98.472608 33.887654)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'restaurant'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-98.582518 33.854202)',4326)::geography, 170000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-98.582518 33.854202)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
