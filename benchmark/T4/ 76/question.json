  "question": "Which gallery fall within 140 kilometers when heading from Lockheed A-12 Blackbird, San Diego, CA toward Navy Gateway Inn and Suites, CA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.153969 32.726821)',4326)::geography, ST_GeomFromText('POINT (-117.19416 32.69891)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'gallery'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-117.153969 32.726821)',4326)::geography, 140000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-117.153969 32.726821)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
