{
  "question": "Which attraction can I find within 180 kilometers while moving from Blue Ocean Discovery Center, Hampton, NH toward the Westin Copley Place, Boston, MA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-70.810543 42.909869)',4326)::geography, ST_GeomFromText('POINT (-71.077203 42.348575)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'attraction'\nAND ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-70.810543 42.909869)',4326)::geography, 180000)\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-70.810543 42.909869)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5);\n",
