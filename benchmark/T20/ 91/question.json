  "question": "Where\u2019s the closest museum along the travel direction toward Extended Stay America - Tacoma/Fife, Fife, WA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-122.941384 46.64061)',4326)::geography, ST_GeomFromText('POINT (-122.390658 47.242589)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-122.941384 46.64061)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-122.941384 46.64061)',4326)::geography ASC\nLIMIT 1;\n",
