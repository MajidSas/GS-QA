  "question": "Where\u2019s the closest fast food restaurant on the journey from Bowditch Middle School Auditorium, Foster City, CA toward Oldest Light Bulb, Livermore, CA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-122.248613 37.559053)',4326)::geography, ST_GeomFromText('POINT (-121.739397 37.680213)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-122.248613 37.559053)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-122.248613 37.559053)',4326)::geography ASC\nLIMIT 1;\n",
