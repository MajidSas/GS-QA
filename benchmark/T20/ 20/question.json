  "question": "Where\u2019s the closest museum that comes up heading toward Chestatee Overlook, Dahlonega, GA from Yellow River Game Ranch, Lilburn, GA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-84.087955 33.833501)',4326)::geography, ST_GeomFromText('POINT (-83.982699 34.665048)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-84.087955 33.833501)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-84.087955 33.833501)',4326)::geography ASC\nLIMIT 1;\n",
