  "question": "Where is the nearest fast food restaurant along the route from Ganyard Hill Farms, Durham, NC to Johnston County Rugby Park, Wilsons Mills, NC?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-78.811548 35.958684)',4326)::geography, ST_GeomFromText('POINT (-78.36109 35.601085)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE amenity = 'fast_food'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-78.811548 35.958684)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-78.811548 35.958684)',4326)::geography ASC\nLIMIT 1;\n",
