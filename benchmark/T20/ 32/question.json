{
  "question": "Where\u2019s the closest hotel positioned on the way to Mount Hope Estate, Manheim, PA from Charlotte's Quest Nature Center, Manchester, MD?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.882917 39.667863)',4326)::geography, ST_GeomFromText('POINT (-76.429747 40.227758)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'hotel'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-76.882917 39.667863)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-76.882917 39.667863)',4326)::geography ASC\nLIMIT 1;\n",
