  "question": "Where\u2019s the closest gallery encountered when moving toward Anything for Princess!, Sewaren, NJ from Hellsgate Farms, Astoria, NY?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.930068 40.768724)',4326)::geography, ST_GeomFromText('POINT (-74.25674 40.562373)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'gallery'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.930068 40.768724)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-73.930068 40.768724)',4326)::geography ASC\nLIMIT 1;\n",
