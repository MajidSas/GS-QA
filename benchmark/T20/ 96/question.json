  "question": "Where\u2019s the closest museum along the travel direction toward Hellsgate Farms, Astoria, NY?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.990094 40.748387)',4326)::geography, ST_GeomFromText('POINT (-73.930068 40.768724)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-73.990094 40.748387)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-73.990094 40.748387)',4326)::geography ASC\nLIMIT 1;\n",
