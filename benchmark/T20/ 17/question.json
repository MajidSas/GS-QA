{
  "question": "Where is the nearest gallery you pass when going from DoubleTree by Hilton Hotel, Bedford, MA to Swan Boats, Boston, MA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-71.236261 42.508756)',4326)::geography, ST_GeomFromText('POINT (-71.069655 42.354037)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'gallery'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-71.236261 42.508756)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-71.236261 42.508756)',4326)::geography ASC\nLIMIT 1;\n",
