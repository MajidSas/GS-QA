  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.080644 42.110128)',4326)::geography, ST_GeomFromText('POINT (-80.202381 42.005387)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE leisure = 'nature_reserve'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.080644 42.110128)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-80.080644 42.110128)',4326)::geography ASC\nLIMIT 1;\n",
