  "question": "Where\u2019s the closest museum positioned on the way to Gannon University, Erie, PA from the Lake House, East Springfield, PA?",
  "sql": "WITH\n    angle AS (SELECT degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.433908 41.993983)',4326)::geography, ST_GeomFromText('POINT (-80.086729 42.128105)',4326)::geography)) AS value)\nSELECT * FROM pois,angle\nWHERE tourism = 'museum'\nAND (degrees(ST_Azimuth(ST_GeomFromText('POINT (-80.433908 41.993983)',4326)::geography, pois.geometry)) BETWEEN angle.value - 22.5 AND angle.value + 22.5)\nORDER BY pois.geometry <-> ST_GeomFromText('POINT (-80.433908 41.993983)',4326)::geography ASC\nLIMIT 1;\n",
