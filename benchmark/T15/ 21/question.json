  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-71.15241 42.415769)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-71.15241 42.415769)',4326)::geography, 170000)\nAND amenity = 'university'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 22.5 AND 67.5;\n",
