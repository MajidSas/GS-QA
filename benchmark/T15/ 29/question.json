{
  "question": "Where can I find a park no more than 150 kilometers away to the northeast of Bowditch Middle School Auditorium, Foster City, CA?",
  "sql": "\nWITH origin AS  (SELECT ST_GeomFromText('POINT (-122.248613 37.559053)',4326)::geography AS geometry)\nSELECT * FROM pois, origin\nWHERE ST_DWithin(pois.geometry, ST_GeomFromText('POINT (-122.248613 37.559053)',4326)::geography, 150000)\nAND leisure = 'park'\nAND degrees(ST_Azimuth(origin.geometry, pois.geometry)) BETWEEN 22.5 AND 67.5;\n",
